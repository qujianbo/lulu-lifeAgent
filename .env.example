APP_NAME=life-agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Public base URL for WeChat callback, for example: https://example.com
PUBLIC_BASE_URL=

# PostgreSQL Docker default. Leave empty to skip readiness check before DB is ready.
POSTGRES_PASSWORD=life_agent
DATABASE_URL=postgresql+asyncpg://life_agent:life_agent@postgres:5432/life_agent

# Redis Docker default. Leave empty to skip readiness check before Redis is ready.
REDIS_URL=redis://redis:6379/0

# DeepSeek. Leave API key empty during resource preparation.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
LLM_TIMEOUT_SECONDS=30

# Web Search fallback. Tavily Free is the default provider.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
# Optional Google Programmable Search fallback.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# WeChat official account. Leave empty until audit/configuration is ready.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# Internal admin token. Set a strong value before exposing admin endpoints.
ADMIN_TOKEN=

# Optional RSS sources for briefing preview. Comma-separated URLs.
# Recommended MVP mix: Chinese tech/business + weekly tech + one international tech source.
BRIEFING_RSS_URLS=https://36kr.com/feed,https://sspai.com/feed,https://www.solidot.org/index.rss,https://feeds.feedburner.com/ruanyifeng,https://www.technologyreview.com/feed/
BRIEFING_RSS_TIMEOUT_SECONDS=8

# Email notification. 163 SMTP usually uses port 465 with an authorization code.
EMAIL_ENABLED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=生活管家 Agent
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
EMAIL_DEFAULT_DAILY_BRIEFING_TIME=09:00
EMAIL_MAX_RETRIES=3

# Agent memory. Keep disabled until mem0 and embedding configuration are ready.
MEMORY_PROVIDER=mem0
MEMORY_ENABLED=false
MEMORY_WRITE_ENABLED=false
MEMORY_SEARCH_TOP_K=5
MEMORY_TIMEOUT_SECONDS=8
MEM0_LLM_PROVIDER=deepseek
MEM0_LLM_MODEL=deepseek-chat
MEM0_LLM_BASE_URL=https://api.deepseek.com
MEM0_LLM_API_KEY=
MEM0_EMBEDDER_PROVIDER=
MEM0_EMBEDDER_MODEL=
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDING_DIMS=
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=life_agent_memories
QDRANT_DISTANCE=Cosine
